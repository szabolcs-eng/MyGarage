<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MyGarage.Pages.VehicleEntryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Vehicle details"
    BackgroundColor="{StaticResource AppBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="20">

            <Border
                BackgroundColor="{StaticResource Primary}"
                StrokeThickness="0"
                Padding="20">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="5">

                    <Label
                        Text="Vehicle details"
                        FontSize="26"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <Label
                        Text="Enter the details of your vehicle"
                        FontSize="14"
                        TextColor="#DCE6F5" />

                </VerticalStackLayout>

            </Border>

            <Border
                BackgroundColor="{StaticResource CardBackground}"
                Stroke="{StaticResource Gray200}"
                StrokeThickness="1"
                Padding="20">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Brand"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />

                    <Entry
                        Placeholder="Example: Volkswagen"
                        Text="{Binding Brand}" />

                    <BoxView
                        HeightRequest="1"
                        Color="{StaticResource Gray200}"
                        Margin="0,0,0,5" />

                    <Label
                        Text="Model"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />

                    <Entry
                        Placeholder="Example: Passat"
                        Text="{Binding Model}" />

                    <BoxView
                        HeightRequest="1"
                        Color="{StaticResource Gray200}"
                        Margin="0,0,0,5" />

                    <Label
                        Text="License plate"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />

                    <Entry
                        Placeholder="Example: ABC-123"
                        Text="{Binding LicensePlate}" />

                    <BoxView
                        HeightRequest="1"
                        Color="{StaticResource Gray200}"
                        Margin="0,0,0,5" />

                    <Label
                        Text="Production year"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />

                    <Entry
                        Placeholder="Example: 2003"
                        Keyboard="Numeric"
                        Text="{Binding Year}" />

                    <Label
                        Text="{Binding ErrorMessage}"
                        TextColor="{StaticResource Danger}"
                        FontSize="14" />

                    <Button
                        Text="Save vehicle"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="{StaticResource Secondary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        Margin="0,10,0,0" />

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
