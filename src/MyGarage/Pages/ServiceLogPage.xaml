<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MyGarage.Pages.ServiceLogPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Service log"
    BackgroundColor="{StaticResource AppBackground}">

    <Grid Padding="18"
          RowDefinitions="Auto,*"
          RowSpacing="20">

        <Border
            Grid.Row="0"
            BackgroundColor="{StaticResource Primary}"
            StrokeThickness="0"
            Padding="20">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="6">

                <Label
                    Text="Service history"
                    FontSize="14"
                    TextColor="#DCE6F5" />

                <Label
                    Text="{Binding SelectedVehicle.Brand}"
                    FontSize="26"
                    FontAttributes="Bold"
                    TextColor="White" />

                <Label
                    Text="{Binding SelectedVehicle.Model}"
                    FontSize="18"
                    TextColor="White" />

                <Label
                    Text="{Binding SelectedVehicle.LicensePlate}"
                    FontSize="14"
                    TextColor="#DCE6F5" />

                <Button
                    Text="+ New service record"
                    Command="{Binding AddServiceRecordCommand}"
                    BackgroundColor="{StaticResource Secondary}"
                    TextColor="White"
                    FontAttributes="Bold"
                    Margin="0,10,0,0" />

            </VerticalStackLayout>

        </Border>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding ServiceRecords}"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="10"
                    Padding="20">

                    <Label
                        Text="No service records yet"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Your service history will appear here."
                        FontSize="14"
                        TextColor="{StaticResource TextSecondary}"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                        Padding="16"
                        Margin="0,0,0,12"
                        BackgroundColor="{StaticResource CardBackground}"
                        Stroke="{StaticResource Gray200}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="12">

                            <Label
                                Text="{Binding Description}"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextPrimary}" />

                            <VerticalStackLayout Spacing="6">

                                <Label
                                    Text="{Binding Date, StringFormat='Date: {0:yyyy.MM.dd}'}"
                                    FontSize="14"
                                    TextColor="{StaticResource TextSecondary}" />

                                <Label
                                    Text="{Binding Odometer, StringFormat='Odometer: {0} km'}"
                                    FontSize="14"
                                    TextColor="{StaticResource TextSecondary}" />

                                <Label
                                    Text="{Binding Cost, StringFormat='Cost: {0} HUF'}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource Primary}" />

                            </VerticalStackLayout>

                            <Image
                                Source="{Binding InvoiceImagePath}"
                                HeightRequest="180"
                                Aspect="AspectFit" />

                            <Button
                                Text="Edit record"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditServiceRecordCommand}"
                                CommandParameter="{Binding .}"
                                BackgroundColor="{StaticResource Tertiary}"
                                TextColor="{StaticResource Primary}" />

                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="10">

                                <Button
                                    Grid.Column="0"
                                    Text="Delete"
                                    BackgroundColor="{StaticResource Danger}"
                                    TextColor="White"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteServiceRecordCommand}"
                                    CommandParameter="{Binding .}" />

                                <Button
                                    Grid.Column="1"
                                    Text="View location"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White"
                                    FontSize="13"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenLocationCommand}"
                                    CommandParameter="{Binding .}" />

                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>
