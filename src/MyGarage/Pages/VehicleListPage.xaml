<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MyGarage.Pages.VehicleListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:MyGarage.Pages"
    Title="My vehicles">

    <Grid Padding="20"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="15">

        <Label
            Text="My vehicles"
            FontSize="26"
            FontAttributes="Bold"
            Grid.Row="0" />

        <Button
            Grid.Row="1"
            Text="Add new vehicle"
            Command="{Binding AddVehicleCommand}" />

        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Vehicles}">

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="10">

                    <Label
                        Text="There is no vehicles to display."
                        FontSize="18"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Your vehicles will appear here."
                        FontSize="14"
                        HorizontalTextAlignment="Center"
                        TextColor="Gray" />

                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                        Padding="15"
                        Margin="0,5"
                        Stroke="#D0D0D0"
                        StrokeThickness="1">

                        <VerticalStackLayout Spacing="8">

                            <Label
                                Text="{Binding Brand}"
                                FontSize="20"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding Model}"
                                FontSize="16" />

                            <Label
                                Text="{Binding LicensePlate}"
                                FontSize="14"
                                TextColor="Gray" />

                            <Label
                                Text="{Binding Year}"
                                FontSize="14"
                                TextColor="Gray" />

                            <Button 
                                Text="View service log"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type pages:VehicleListPage}}, Path=BindingContext.OpenServiceLogCommand}"
                                CommandParameter="{Binding .}"/>

                            <Button
                                Text="Edit vehicle"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type pages:VehicleListPage}}, Path=BindingContext.EditVehicleCommand}"
                                CommandParameter="{Binding .}" />

                            <Button
                                Text="Delete vehicle"
                                BackgroundColor="#C62828"
                                TextColor="White"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type pages:VehicleListPage}}, Path=BindingContext.DeleteVehicleCommand}"
                                CommandParameter="{Binding .}" />

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>