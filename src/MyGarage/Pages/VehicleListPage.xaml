<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MyGarage.Pages.VehicleListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:MyGarage.Pages"
    Title="MyGarage"
    BackgroundColor="{StaticResource AppBackground}">

    <Grid Padding="18"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="20">

        <Border
            Grid.Row="0"
            BackgroundColor="{StaticResource Primary}"
            StrokeThickness="0"
            Padding="20">

            <VerticalStackLayout Spacing="5">

                <Label
                    Text="MyGarage"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="White" />

                <Label
                    Text="Manage your vehicles"
                    FontSize="14"
                    TextColor="#DCE6F5" />

            </VerticalStackLayout>

        </Border>

        <VerticalStackLayout
            Grid.Row="1"
            Spacing="12">

            <Label
                Text="My vehicles"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="{StaticResource TextPrimary}" />

            <Button
                Text="+ Add new vehicle"
                Command="{Binding AddVehicleCommand}"
                BackgroundColor="{StaticResource Secondary}"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="12" />

        </VerticalStackLayout>

        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Vehicles}"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="10"
                    Padding="20">

                    <Label
                        Text="No vehicles yet"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Add your first vehicle to get started."
                        FontSize="14"
                        TextColor="{StaticResource TextSecondary}"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                        Padding="16"
                        Margin="0,0,0,12"
                        BackgroundColor="{StaticResource CardBackground}"
                        Stroke="{StaticResource Gray200}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="12">

                            <VerticalStackLayout Spacing="4">

                                <Label
                                    Text="{Binding Brand}"
                                    FontSize="21"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimary}" />

                                <Label
                                    Text="{Binding Model}"
                                    FontSize="17"
                                    TextColor="{StaticResource TextPrimary}" />

                                <Grid
                                    ColumnDefinitions="*,*"
                                    Margin="0,6,0,0">

                                    <Label
                                        Grid.Column="0"
                                        Text="{Binding LicensePlate}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource TextSecondary}" />

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Year}"
                                        FontSize="14"
                                        TextColor="{StaticResource TextSecondary}"
                                        HorizontalTextAlignment="End" />

                                </Grid>

                            </VerticalStackLayout>

                            <Button
                                Text="View service log"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type pages:VehicleListPage}}, Path=BindingContext.OpenServiceLogCommand}"
                                CommandParameter="{Binding .}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White" />

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="10">

                                <Button
                                    Grid.Column="0"
                                    Text="Edit"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type pages:VehicleListPage}}, Path=BindingContext.EditVehicleCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="{StaticResource Tertiary}"
                                    TextColor="{StaticResource Primary}" />

                                <Button
                                    Grid.Column="1"
                                    Text="Delete"
                                    BackgroundColor="{StaticResource Danger}"
                                    TextColor="White"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type pages:VehicleListPage}}, Path=BindingContext.DeleteVehicleCommand}"
                                    CommandParameter="{Binding .}" />

                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>
