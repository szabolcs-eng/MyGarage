<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MyGarage.Pages.ServiceEntryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Service details"
    BackgroundColor="{StaticResource AppBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="20">

            <Border
                BackgroundColor="{StaticResource Primary}"
                StrokeThickness="0"
                Padding="20">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="5">

                    <Label
                        Text="Service details"
                        FontSize="26"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <Label
                        Text="Record your vehicle maintenance"
                        FontSize="14"
                        TextColor="#DCE6F5" />

                </VerticalStackLayout>

            </Border>

            <Border
                BackgroundColor="{StaticResource CardBackground}"
                Stroke="{StaticResource Gray200}"
                StrokeThickness="1"
                Padding="20">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Service information"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Primary}" />

                    <Label
                        Text="Date"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />

                    <Entry
                        Placeholder="YYYY-MM-DD"
                        Text="{Binding Date}" />

                    <BoxView
                        HeightRequest="1"
                        Color="{StaticResource Gray200}" />

                    <Label
                        Text="Odometer reading (km)"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />

                    <Entry
                        Placeholder="Example: 245000"
                        Keyboard="Numeric"
                        Text="{Binding Odometer}" />

                    <BoxView
                        HeightRequest="1"
                        Color="{StaticResource Gray200}" />

                    <Label
                        Text="Service description"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />

                    <Editor
                        Placeholder="Example: Engine oil and oil filter change"
                        AutoSize="TextChanges"
                        HeightRequest="100"
                        Text="{Binding Description}" />

                    <BoxView
                        HeightRequest="1"
                        Color="{StaticResource Gray200}" />

                    <Label
                        Text="Cost (HUF)"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />

                    <Entry
                        Placeholder="Example: 45000"
                        Keyboard="Numeric"
                        Text="{Binding Cost}" />

                    <Label
                        Text="{Binding ErrorMessage}"
                        TextColor="{StaticResource Danger}"
                        FontSize="14" />

                </VerticalStackLayout>

            </Border>

            <Border
                BackgroundColor="{StaticResource CardBackground}"
                Stroke="{StaticResource Gray200}"
                StrokeThickness="1"
                Padding="20">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Invoice or parts photo"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Primary}" />

                    <Label
                        Text="Take a photo of your invoice or replaced parts."
                        FontSize="13"
                        TextColor="{StaticResource TextSecondary}" />

                    <Button
                        Text="Take photo"
                        Command="{Binding TakePhotoCommand}"
                        BackgroundColor="{StaticResource Secondary}"
                        TextColor="White" />

                    <Image
                        Source="{Binding InvoiceImagePath}"
                        HeightRequest="200"
                        Aspect="AspectFit" />

                </VerticalStackLayout>

            </Border>

            <Border
                BackgroundColor="{StaticResource CardBackground}"
                Stroke="{StaticResource Gray200}"
                StrokeThickness="1"
                Padding="20">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Service location"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Primary}" />

                    <Label
                        Text="Save the location where the service was performed."
                        FontSize="13"
                        TextColor="{StaticResource TextSecondary}" />

                    <Button
                        Text="Get location"
                        Command="{Binding GetLocationCommand}"
                        BackgroundColor="{StaticResource Tertiary}"
                        TextColor="{StaticResource Primary}" />

                    <Label
                        Text="{Binding LocationLat, StringFormat='Latitude: {0}'}"
                        FontSize="13"
                        TextColor="{StaticResource TextSecondary}" />

                    <Label
                        Text="{Binding LocationLon, StringFormat='Longitude: {0}'}"
                        FontSize="13"
                        TextColor="{StaticResource TextSecondary}" />

                </VerticalStackLayout>

            </Border>

            <Button
                Text="Save service record"
                Command="{Binding SaveCommand}"
                BackgroundColor="{StaticResource Secondary}"
                TextColor="White"
                FontAttributes="Bold"
                Margin="0,0,0,10" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
